# Passflat Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Used by the admin client (storage cleanup, password-reset
# link generation). NEVER expose to the browser / import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase Postgres in production, local Docker for dev)
# Local dev: postgresql://passflat:passflat@localhost:5433/passflat
# Production: your Supabase pooler URL
DATABASE_URL=
DIRECT_URL=

# Google Places API
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs
STRIPE_PRICE_EXTRA_LISTING=
STRIPE_PRICE_PROMOTE_7=
STRIPE_PRICE_PROMOTE_14=
STRIPE_PRICE_PROMOTE_30=
STRIPE_PRICE_COST_ACCESS_7=
STRIPE_PRICE_COST_ACCESS_30=
STRIPE_PRICE_COST_ACCESS_90=

# Resend (email)
RESEND_API_KEY=
# Sender identity for all outgoing transactional email. Defaults to
RESEND_FROM=
# Inbox that receives contact-form submissions. Defaults to contact@passflat.com.
CONTACT_EMAIL=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics 4 (analytics)
# GA4 Measurement ID, format G-XXXXXXXXXX. Leave empty to disable GA entirely
# (no gtag.js is loaded). GA is additionally consent-gated: it only loads after
# the user accepts analytics in the cookie-consent banner.
NEXT_PUBLIC_GA_ID=

# Vercel Cron
CRON_SECRET=

# DeepL (translation)
DEEPL_API_KEY=

# Cost import admins (server-only config, NOT a secret)
# Comma-separated list of emails allowed to use the cost form's "fill on behalf"
# mode: reports they submit are owned by the system import profile and tagged
# with an optional owner email, so they auto-link when that person logs in.
# Leave empty to disable the feature entirely. Matched case-insensitively.
# e.g. COST_IMPORT_ADMIN_EMAILS=alice@passflat.com,bob@passflat.com
COST_IMPORT_ADMIN_EMAILS=

# Admin import mode for the cost form (server-only). Shares the allowlist above;
ADMIN_IMPORT_MODE=

# App
# Single canonical site origin (the one source of truth for the domain). Used
# for canonical URLs, the sitemap, robots, Stripe checkout redirects, auth
# callbacks and outgoing email links. No trailing slash. Production MUST set
# this to the real origin, e.g. https://passflat.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Features (build-time toggles)
# Downloadable legal-document templates (resources page, listing/how-it-works/blog
# download blocks, chat hint). Enabled by default; set to "false" to fully disable
# the feature (components render nothing, /resources returns 404, footer + sitemap
# entries removed). Any value other than "false" (incl. unset) keeps it enabled.
NEXT_PUBLIC_FEATURE_DOCUMENT_TEMPLATES=true

# Open all crowdsourced cost data to everyone (build-time toggle). Phase 1 of the
# growth plan runs fully open to power SEO, social sharing and proof-of-value:
# anonymous visitors and crawlers see every number, with no contribute-/pay-to-
# unlock gate. Set to "false" to reinstate the gate (contribute one report or buy
# access to view). Any value other than "false" (incl. unset) keeps it OPEN.
NEXT_PUBLIC_FEATURE_COST_DATA_OPEN=true

# Search-engine indexing (build-time toggle, fail-safe = blocked)
# Set to "true" ONLY at launch to allow Google et al. to index the site. Any
# other value (unset, "false", typo) keeps the ENTIRE site non-indexable:
# robots.txt disallows everything and every page emits robots: noindex,nofollow.
# This is a NEXT_PUBLIC_ var inlined at build time — flipping it requires a redeploy.
NEXT_PUBLIC_SITE_INDEXABLE=false
