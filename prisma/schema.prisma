generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Geography ---

model Country {
  id               String    @id // 'pl', 'de', 'cz'
  nameKey          String    @map("name_key")
  currency         String
  defaultLocale    String    @map("default_locale")
  supportedLocales String[]  @map("supported_locales")
  isActive         Boolean   @default(false) @map("is_active")
  launchedAt       DateTime? @map("launched_at")

  cities         City[]
  costTermLabels CostTermLabel[]

  @@map("countries")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  countryId String   @map("country_id")
  slug      String   @unique
  nameKey   String   @map("name_key")
  lat       Decimal?
  lng       Decimal?
  bounds    Json?
  timezone  String?
  isActive  Boolean  @default(false) @map("is_active")

  country   Country    @relation(fields: [countryId], references: [id])
  districts District[]
  buildings Building[]
  profiles  Profile[]

  @@map("cities")
}

model District {
  id      String @id @default(uuid()) @db.Uuid
  cityId  String @map("city_id") @db.Uuid
  slug    String
  nameKey String @map("name_key")
  bounds  Json?

  city      City       @relation(fields: [cityId], references: [id])
  buildings Building[]

  @@unique([cityId, slug])
  @@map("districts")
}

// --- Buildings ---

model Building {
  id                    String   @id @default(uuid()) @db.Uuid
  slug                  String
  cityId                String   @map("city_id") @db.Uuid
  districtId            String?  @map("district_id") @db.Uuid
  street                String
  buildingNumber        String   @map("building_number")
  addressFull           String   @map("address_full")
  addressNormalized     String   @map("address_normalized")
  lat                   Decimal?
  lng                   Decimal?
  placeId               String?  @map("place_id")
  postalCode            String?  @map("postal_code")
  totalApartmentsApprox Int?     @map("total_apartments_approx")
  buildingType          String?  @map("building_type")
  yearBuilt             Int?     @map("year_built")
  createdAt             DateTime @default(now()) @map("created_at")

  city          City                   @relation(fields: [cityId], references: [id])
  district      District?              @relation(fields: [districtId], references: [id])
  listings      Listing[]
  costReports   CostReport[]
  locationScore BuildingLocationScore?

  @@unique([cityId, slug])
  @@unique([cityId, addressNormalized])
  @@index([districtId])
  @@map("buildings")
}

model BuildingLocationScore {
  buildingId String   @id @map("building_id") @db.Uuid
  overall    Int
  categories Json
  computedAt DateTime @default(now()) @map("computed_at")
  version    Int      @default(1)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("building_location_scores")
}

// --- Listings ---

model Listing {
  id         String @id @default(uuid()) @db.Uuid
  buildingId String @map("building_id") @db.Uuid
  authorId   String @map("author_id") @db.Uuid

  type            String  @default("replacement") // 'replacement' | 'roommate' | 'sublet'
  apartmentNumber String? @map("apartment_number")

  title       String
  description String?
  locale      String?

  // --- Common pricing ---
  currency     String
  rent         Decimal?
  adminFee     Decimal? @map("admin_fee")
  utilitiesAvg Decimal? @map("utilities_avg")
  totalMonthly Decimal? @map("total_monthly")

  // --- Replacement-specific ---
  leaseType     String?   @map("lease_type")
  leaseEndDate  DateTime? @map("lease_end_date") @db.Date
  availableFrom DateTime? @map("available_from") @db.Date
  depositAmount Decimal?  @map("deposit_amount")

  // --- Roommate-specific ---
  pricePerPerson      Decimal? @map("price_per_person")
  totalApartmentRent  Decimal? @map("total_apartment_rent")
  currentRoommates    Int?     @map("current_roommates")
  totalRooms          Int?     @map("total_rooms")
  roomType            String?  @map("room_type") // 'private' | 'shared'
  preferredGender     String?  @map("preferred_gender") // 'any' | 'male' | 'female'
  preferredAgeMin     Int?     @map("preferred_age_min")
  preferredAgeMax     Int?     @map("preferred_age_max")
  roommateDescription String?  @map("roommate_description")

  // --- Sublet-specific ---
  availableTo       DateTime? @map("available_to") @db.Date
  priceTotal        Decimal?  @map("price_total")
  utilitiesIncluded Boolean?  @map("utilities_included")
  internetIncluded  Boolean?  @map("internet_included")
  subletRules       String?   @map("sublet_rules")

  // --- Common apartment details ---
  rooms                Int?
  areaM2               Decimal? @map("area_m2")
  floor                Int?
  amenities            String[]
  thingsToKnow         String[] @map("things_to_know")
  registrationPossible Boolean? @map("registration_possible")

  photos String[]

  // --- Moderation & promotion ---
  status        String    @default("active")
  isPaid        Boolean   @default(false) @map("is_paid")
  paidAt        DateTime? @map("paid_at")
  isPromoted    Boolean   @default(false) @map("is_promoted")
  promotedUntil DateTime? @map("promoted_until")
  isVerified    Boolean   @default(false) @map("is_verified")

  viewsCount     Int @default(0) @map("views_count")
  responsesCount Int @default(0) @map("responses_count")

  expiresAt          DateTime? @map("expires_at")
  expiringNotifiedAt DateTime? @map("expiring_notified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  building        Building                @relation(fields: [buildingId], references: [id])
  author          Profile                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  responses       ListingResponse[]
  savedBy         SavedListing[]
  conversations   Conversation[]
  views           ListingView[]
  translations    ListingTranslation[]
  periodicCharges ListingPeriodicCharge[]

  @@map("listings")
}

model ListingPeriodicCharge {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  category  String // 'water' | 'electricity' | 'gas' | 'heating' | 'other'
  amount    Decimal
  frequency String // 'bimonthly' | 'quarterly' | 'semiannual' | 'annual'
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_periodic_charges")
}

model ListingTranslation {
  id        String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  locale    String

  title               String?
  description         String?
  roommateDescription String? @map("roommate_description")
  subletRules         String? @map("sublet_rules")

  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, locale])
  @@map("listing_translations")
}

model ListingResponse {
  id          String   @id @default(uuid()) @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  responderId String   @map("responder_id") @db.Uuid
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  listing   Listing @relation(fields: [listingId], references: [id])
  responder Profile @relation(fields: [responderId], references: [id], onDelete: Cascade)

  @@map("listing_responses")
}

model SavedListing {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("saved_listings")
}

model ListingView {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  viewerHash String   @map("viewer_hash")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, viewerHash])
  @@index([listingId, viewedAt])
  @@map("listing_views")
}

// --- Cost Reports ---

model CostReport {
  id         String @id @default(uuid()) @db.Uuid
  buildingId String @map("building_id") @db.Uuid
  authorId   String @map("author_id") @db.Uuid

  currency            String
  rent                Decimal?
  adminFee            Decimal? @map("admin_fee")
  electricityAvg      Decimal? @map("electricity_avg")
  electricityWinter   Decimal? @map("electricity_winter")
  electricitySummer   Decimal? @map("electricity_summer")
  electricityIncluded Boolean? @map("electricity_included")
  gas                 Decimal? @map("gas")
  heating             Decimal? @map("heating")
  heatingWinter       Decimal? @map("heating_winter")
  heatingSummer       Decimal? @map("heating_summer")
  heatingIncluded     Boolean? @map("heating_included")
  water               Decimal? @map("water")
  waterIncluded       Boolean? @map("water_included")
  internet            Decimal? @map("internet")
  internetProvider    String?  @map("internet_provider")
  otherCosts          Decimal? @map("other_costs")
  otherCostsNote      String?  @map("other_costs_note")
  // Whether utilities are accounted for in totalMonthlyAvg:
  //   true  = amount given, "included in rent", or a detailed breakdown → total is complete
  //   false = tenant didn't know → total understates real cost
  //   null  = legacy / not answered
  utilitiesComplete   Boolean? @map("utilities_complete")
  totalMonthlyAvg     Decimal? @map("total_monthly_avg")

  rooms  Int?
  areaM2 Decimal? @map("area_m2")
  floor  Int?

  rentalType            String?  @map("rental_type")
  leaseType             String?  @map("lease_type")
  depositMonths         Decimal? @map("deposit_months")
  depositAmount         Decimal? @map("deposit_amount")
  depositReturned       Boolean? @map("deposit_returned")
  depositReturnDays     Int?     @map("deposit_return_days")
  depositReturnedAmount Decimal? @map("deposit_returned_amount")

  livedFrom       DateTime? @map("lived_from") @db.Date
  livedUntil      DateTime? @map("lived_until") @db.Date
  isCurrentTenant Boolean?  @map("is_current_tenant")

  verificationStatus String  @default("unverified") @map("verification_status")
  isVisible          Boolean @default(true) @map("is_visible")

  // Source & email-claim (for imported submissions, e.g. Google Form)
  source        String    @default("user") // 'user' | 'import'
  importedEmail String?   @map("imported_email") // normalized lowercase, used to auto-link on login
  claimedAt     DateTime? @map("claimed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  building        Building                   @relation(fields: [buildingId], references: [id])
  author          Profile                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  periodicCharges CostReportPeriodicCharge[]

  @@index([buildingId])
  @@index([authorId])
  @@index([importedEmail])
  @@map("cost_reports")
}

model CostReportPeriodicCharge {
  id           String   @id @default(uuid()) @db.Uuid
  costReportId String   @map("cost_report_id") @db.Uuid
  category     String // 'water' | 'electricity' | 'gas' | 'heating' | 'other'
  amount       Decimal
  frequency    String // 'bimonthly' | 'quarterly' | 'semiannual' | 'annual'
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  costReport CostReport @relation(fields: [costReportId], references: [id], onDelete: Cascade)

  @@index([costReportId])
  @@map("cost_report_periodic_charges")
}

model CostTermLabel {
  id         String  @id @default(uuid()) @db.Uuid
  countryId  String  @map("country_id")
  fieldName  String  @map("field_name")
  labelKey   String  @map("label_key")
  tooltipKey String? @map("tooltip_key")

  country Country @relation(fields: [countryId], references: [id])

  @@unique([countryId, fieldName])
  @@map("cost_term_labels")
}

// --- Users ---

model Profile {
  id                 String    @id @db.Uuid // = auth.users.id
  displayName        String?   @map("display_name")
  email              String?   @unique
  locale             String?
  cityId             String?   @map("city_id") @db.Uuid
  contactMethod      String?   @map("contact_method")
  contactValue       String?   @map("contact_value")
  hasContributedCost Boolean   @default(false) @map("has_contributed_cost")
  costAccessUntil    DateTime? @map("cost_access_until")
  isVerified         Boolean   @default(false) @map("is_verified")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  city                     City?                     @relation(fields: [cityId], references: [id])
  listings                 Listing[]
  listingResponses         ListingResponse[]
  costReports              CostReport[]
  payments                 Payment[]
  subscriptions            Subscription[]
  reports                  Report[]
  savedListings            SavedListing[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]

  @@map("profiles")
}

// --- Chat ---

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing      Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --- Payments ---

model Payment {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  stripeCheckoutSessionId String?   @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id")
  productType             String    @map("product_type")
  referenceId             String?   @map("reference_id") @db.Uuid
  amount                  Int
  currency                String
  status                  String
  consentAccepted         Boolean   @default(false) @map("consent_accepted")
  consentAt               DateTime? @map("consent_at")
  consentText             String?   @map("consent_text")
  refundedAt              DateTime? @map("refunded_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  planType             String    @map("plan_type")
  status               String
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --- Moderation ---

model Report {
  id             String   @id @default(uuid()) @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  targetType     String   @map("target_type")
  targetId       String   @map("target_id") @db.Uuid
  reason         String
  status         String   @default("pending")
  moderatorNotes String?  @map("moderator_notes")
  createdAt      DateTime @default(now()) @map("created_at")

  reporter Profile @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// --- City notify waitlist ---

model CityNotifySubscription {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  city           String
  cityNormalized String    @map("city_normalized")
  locale         String?
  consent        Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  notifiedAt     DateTime? @map("notified_at")

  @@unique([email, cityNormalized])
  @@index([cityNormalized])
  @@map("city_notify_subscriptions")
}
